# Copiar a .env y completar. NUNCA subir el .env real al repositorio.

# Requerida
DATABASE_URL=postgresql://usuario:password@localhost:5432/medclinical
# Minimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Origenes del frontend separados por coma. Nunca usar "*": app.enableCors() con comodin
# permitiria que cualquier sitio llame a la API.
CORS_ORIGINS=http://localhost:5173

# Opcionales
PORT=3000
# Pool de Postgres: max x numero de procesos del servidor no debe superar max_connections
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
NODE_ENV=development
