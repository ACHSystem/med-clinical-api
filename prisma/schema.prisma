generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DOCTOR
  ASSISTANT
}

// Identidad de la persona. NO es el tenant: un mismo User puede trabajar en varias Clinicas.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  lastName  String
  role      Role     @default(ASSISTANT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      ClinicUser[]
  createdHistories MedicalHistory[] @relation("HistoryAuthor")
  createdQuotes    Quote[]          @relation("QuoteAuthor")
}

// Tenant: el consultorio. Todos los datos de negocio cuelgan de aqui, no del User.
model Clinic {
  id        String   @id @default(uuid())
  name      String
  taxId     String? // RIF/NIT/identificacion fiscal
  slug      String? // para URLs por consultorio
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          ClinicUser[]
  patients         Patient[]
  medicalHistories MedicalHistory[]
  quotes           Quote[]
  templates        FormTemplate[]
  providers        Provider[]
  serviceCosts     ServiceCost[]
  paymentMethods   PaymentMethod[]

  @@unique([slug])
  @@index([isActive])
}

// Membresia:Many-to-many entre User y Clinic.
// Permite 1 medico en varias clinicas y 2 medicos en la misma clinica.
model ClinicUser {
  clinicId  String
  userId    String
  role      Role     @default(ASSISTANT) // rol DENTRO de esta clinica
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clinicId, userId])
  @@index([userId])
}

// Pacientes
model Patient {
  id        String    @id @default(uuid())
  name      String
  lastName  String
  identify  String
  email     String?
  phone     String?
  birthDate DateTime?
  gender    String?
  address   String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  clinicId         String
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  medicalHistories MedicalHistory[]
  quotes           Quote[]

  @@index([clinicId, isActive])
  @@index([clinicId, identify])
}

// Proveedores (datos de la clinica: laboratorios, transporte...)
model Provider {
  id           String   @id @default(uuid())
  name         String
  type         String
  businessName String
  identify     String
  email        String?
  phone        String?
  address      String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  services ProviderService[]

  @@index([clinicId, isActive])
}

// Servicios de proveedores
model ProviderService {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isActive])
}

// Plantilla de formulario reutilizable por condicion clinica.
// Un historial guarda templateId (opcional) + templateSnapshot, de modo que la
// historia sigue siendo legible aunque la plantilla cambie o se desactive.
model FormTemplate {
  id          String   @id @default(uuid())
  name        String
  condition   String?
  description String?
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  fields           CustomField[]
  medicalHistories MedicalHistory[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

// Campos de una plantilla. OJO: fieldType es texto libre a proposito (el admin
// crea los tipos que necesite), no es un enum.
model CustomField {
  id         String   @id @default(uuid())
  name       String
  fieldType  String
  isRequired Boolean  @default(false)
  options    String[]
  sortOrder  Int
  step       Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit        String?
  helpText    String?
  placeholder String?
  minValue    Float?
  maxValue    Float?

  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, step, sortOrder])
  @@index([templateId, isActive])
}

//Historias medicas
model MedicalHistory {
  id               String   @id @default(uuid())
  title            String
  data             Json
  notes            String
  type             String?
  // Copia de la definicion de la plantilla en el momento del guardado
  templateSnapshot Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  createdById String
  createdBy   User          @relation("HistoryAuthor", fields: [createdById], references: [id])
  templateId  String?
  template    FormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@index([createdById])
}

//Costos y Servicios
model ServiceCost {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, isActive])
}

// Historial del Dolar. GLOBAL a proposito: es una cotizacion publica, no dato de clinica.
model Dolar {
  id        String   @id @default(uuid())
  value     Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]
}

// Metodos de pago
model PaymentMethod {
  id        String   @id @default(uuid())
  bank      String
  identify  String
  phone     String
  email     String
  account   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, isActive])
}

// Presupuesto
model Quote {
  id          String    @id @default(uuid())
  title       String
  description String?
  date        DateTime  @default(now())
  validUntil  DateTime?
  dolarId     String
  dolar       Dolar     @relation(fields: [dolarId], references: [id])
  total       Decimal   @db.Decimal(10, 2)
  status      String    @default("pending")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  clinicId    String
  clinic      Clinic  @relation(fields: [clinicId], references: [id])
  createdById String
  createdBy   User    @relation("QuoteAuthor", fields: [createdById], references: [id])

  items QuoteItem[]

  @@index([clinicId, createdAt])
  @@index([patientId])
  @@index([createdById])
}

// Elementos del presupuesto
model QuoteItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
