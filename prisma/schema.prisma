generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  ASSISTANT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SIGN
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ATTENDED
  NO_SHOW
  CANCELLED
  RESCHEDULED
}

// Identidad de la persona. NO es el tenant: un mismo User puede trabajar en varias Clinicas.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  name      String
  lastName  String
  role      Role     @default(ASSISTANT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      ClinicUser[]
  createdHistories MedicalHistory[] @relation("HistoryAuthor")
  signedHistories  MedicalHistory[] @relation("HistorySigner")
  createdQuotes    Quote[]          @relation("QuoteAuthor")
  appointments     Appointment[]
  auditLogs        AuditLog[]
}

// Tenant: el consultorio. Todos los datos de negocio cuelgan de aqui, no del User.
model Clinic {
  id        String   @id @default(uuid())
  name      String
  taxId     String? // RIF/NIT/identificacion fiscal
  slug      String? // para URLs por consultorio
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             ClinicUser[]
  patients            Patient[]
  medicalHistories    MedicalHistory[]
  quotes              Quote[]
  templates           FormTemplate[]
  providers           Provider[]
  serviceCosts        ServiceCost[]
  paymentMethods      PaymentMethod[]
  TreatmentMedication TreatmentMedication[]
  appointments        Appointment[]
  medications         Medication[]
  medicalTreatments   MedicalTreatments[]
  auditLogs           AuditLog[]

  @@unique([slug])
  @@index([isActive])
}

// Membresia:Many-to-many entre User y Clinic.
// Permite 1 medico en varias clinicas y 2 medicos en la misma clinica.
model ClinicUser {
  clinicId  String
  userId    String
  role      Role     @default(ASSISTANT) // rol DENTRO de esta clinica
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clinicId, userId])
  @@index([userId])
}

// Pacientes
model Patient {
  id        String    @id @default(uuid())
  name      String
  lastName  String
  identify  String
  email     String?
  phone     String?
  birthDate DateTime?
  gender    String?
  address   String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  clinicId         String
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  medicalHistories MedicalHistory[]
  quotes           Quote[]
  appointments     Appointment[]

  @@unique([clinicId, identify])
  @@index([clinicId, identify])
}

// Plantilla de formulario reutilizable por condicion clinica.
// Un historial guarda templateId (opcional) + templateSnapshot, de modo que la
// historia sigue siendo legible aunque la plantilla cambie o se desactive.
model FormTemplate {
  id          String   @id @default(uuid())
  name        String
  condition   String?
  description String?
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  fields           CustomField[]
  medicalHistories MedicalHistory[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
}

// Campos de una plantilla. OJO: fieldType es texto libre a proposito (el admin
// crea los tipos que necesite), no es un enum.
model CustomField {
  id         String   @id @default(uuid())
  name       String
  fieldType  String
  isRequired Boolean  @default(false)
  options    String[]
  sortOrder  Int
  step       Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unit        String?
  helpText    String?
  placeholder String?
  minValue    Float?
  maxValue    Float?

  templateId String
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, step, sortOrder])
  @@index([templateId, isActive])
}

model Appointment {
  id String @id @default(uuid())

  // Cuándo
  scheduledAt   DateTime // fecha + hora juntas (más simple para ordenar y filtrar)
  durationMin   Int       @default(30)
  confirmedAt   DateTime? // cuándo confirmó el paciente
  attendedAt    DateTime? // cuándo se atendió realmente
  cancelledAt   DateTime?
  rescheduledAt DateTime?
  noShowAt      DateTime?

  // Qué
  type    String            @default("GENERAL_CONSULT")
  status  AppointmentStatus @default(SCHEDULED)
  reason  String? // motivo breve que dio el paciente
  notes   String? // notas internas de la secretaria/médico
  channel String            @default("IN_PERSON")

  // Quién
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])
  clinicId  String
  clinic    Clinic  @relation(fields: [clinicId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  // Vínculo con la historia (1:1 opcional desde la cita hacia la historia)
  medicalHistoryId String?         @unique
  medicalHistory   MedicalHistory? @relation(fields: [medicalHistoryId], references: [id], onDelete: SetNull)

  // Reagendamiento: la cita hija apunta a la original. Cada cita solo puede
  // originar una hija directa, por eso el indice es unico.
  rescheduledFromId String?      @unique
  rescheduledFrom   Appointment? @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Appointment? @relation("AppointmentReschedule")

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, scheduledAt])
  @@index([patientId, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([clinicId, status, scheduledAt])
}

//Historias medicas
model MedicalHistory {
  id    String @id @default(uuid())
  title String
  type  String

  reason       String
  symptoms     String
  notes        String
  observations String

  diagnosis  String
  evaluation String

  date   DateTime
  status String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  vitalSigns Json?

  //Datos de la plantilla y su plantilla
  data       Json?
  templateId String?
  template   FormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  //Tratamientos y medicamentos asociados a la historia
  medicalTreatments MedicalTreatments[]

  // Cita asociada a la historia (opcional, 1:1)
  appointment Appointment?

  deleted   Boolean   @default(false)
  deletedAt DateTime?

  // Copia de la definicion de la plantilla en el momento del guardado
  templateSnapshot Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  createdById      String
  createdBy        User     @relation("HistoryAuthor", fields: [createdById], references: [id])

  signedAt   DateTime?
  signedById String?
  signedBy   User?     @relation("HistorySigner", fields: [signedById], references: [id], onDelete: SetNull)

  @@index([clinicId, patientId, createdAt, type, status])
  @@index([createdById])
  @@index([signedById])
}

model MedicalTreatments {
  id               String         @id @default(uuid())
  medicalHistoryId String
  medicalHistory   MedicalHistory @relation(fields: [medicalHistoryId], references: [id], onDelete: Cascade)
  clinicId         String
  clinic           Clinic         @relation(fields: [clinicId], references: [id])

  // Plan general (no farmacológico)
  title           String? // "Plan de manejo HTA"
  plan            String? // indicaciones generales (dieta, reposo, etc.)
  recommendations String?
  notes           String?

  // NUEVO
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  medication           Medication?           @relation(fields: [medicationId], references: [id])
  medicationId         String?
  treatmentMedications TreatmentMedication[]

  @@index([clinicId])
}

// ── Catálogo de medicamentos (reutilizable por clínica) ───────
model Medication {
  id               String  @id @default(uuid())
  name             String // "Losartán"
  activeIngredient String? // "Losartán potásico"
  presentation     String? // "Tableta"
  concentration    String? // "50 mg"
  form             String? // "VO", "IV", "IM", "Tópico"
  notes            String?

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  prescriptions TreatmentMedication[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  medicalTreatments MedicalTreatments[]

  @@unique([clinicId, name, concentration])
  @@index([clinicId])
  @@index([clinicId, name])
}

// ── Indicación concreta de un medicamento en un tratamiento ───
model TreatmentMedication {
  id                 String            @id @default(uuid())
  medicalTreatmentId String
  medicalTreatment   MedicalTreatments @relation(fields: [medicalTreatmentId], references: [id], onDelete: Cascade)

  // Vínculo opcional al catálogo
  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  // Snapshot: se congela al guardar por si el catálogo cambia
  medicationName   String
  activeIngredient String?
  presentation     String?
  concentration    String?

  // Indicación
  dose         String // "50 mg"
  frequency    String // "cada 12 horas"
  route        String? // "VO"
  duration     String? // "30 días"
  quantity     String? // "1 tableta"
  instructions String? // indicación específica de ESTE fármaco
  notes        String?

  startDate DateTime?
  endDate   DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic?  @relation(fields: [clinicId], references: [id])
  clinicId  String?

  @@index([medicalTreatmentId, sortOrder])
  @@index([medicationId])
}

// ------------------------------------------------------------------------------------------ //

// Proveedores (datos de la clinica: laboratorios, transporte...)
model Provider {
  id           String   @id @default(uuid())
  name         String
  type         String // "LAB" | "IMAGING" | "PHARMACY" | "EXTERNAL_DOCTOR" | "SUPPLIES" | "OTHER"
  businessName String
  identify     String
  email        String?
  phone        String?
  address      String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  services ProviderService[]

  @@unique([clinicId, identify])
  @@index([clinicId, isActive])
}

// Servicios de proveedores
model ProviderService {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  quoteItems QuoteItem[]

  @@index([providerId, isActive])
}

//Costos y Servicios
model ServiceCost {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  quoteItems QuoteItem[]

  @@index([clinicId, isActive])
}

// Historial del Dolar. GLOBAL a proposito: es una cotizacion publica, no dato de clinica.
model Dolar {
  id        String   @id @default(uuid())
  value     Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes Quote[]

  @@unique([date, value])
  @@index([date])
}

// Registro inmutable de quien creo, modifico, firmo o borro datos clinicos y comerciales.
// metadata solo guarda nombres de campos/estados, nunca contenido clinico ni datos personales.
model AuditLog {
  id        String      @id @default(uuid())
  clinicId  String?
  clinic    Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  entity    String
  entityId  String
  action    AuditAction
  metadata  Json?
  ipAddress String?
  requestId String?
  createdAt DateTime    @default(now())

  @@index([clinicId, createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
}

// Metodos de pago
model PaymentMethod {
  id        String   @id @default(uuid())
  bank      String
  type      String
  identify  String
  phone     String
  email     String
  account   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  quotes Quote[]

  @@index([clinicId, isActive])
}

// Presupuesto versionado. Un presupuesto emitido es inmutable: se edita el DRAFT
// o se crea una nueva version con /revise.
model Quote {
  id           String      @id @default(uuid())
  title        String
  description  String?
  date         DateTime    @default(now())
  validUntil   DateTime?
  dolarId      String
  dolar        Dolar       @relation(fields: [dolarId], references: [id])
  currency     String      @default("USD")
  exchangeRate Decimal     @db.Decimal(12, 4)
  subtotal     Decimal     @db.Decimal(12, 2)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  tax          Decimal     @default(0) @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  status       QuoteStatus @default(DRAFT)
  version      Int         @default(1)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Versionado: la raiz se referencia a si misma; cada revision apunta a la anterior.
  rootQuoteId  String?
  rootQuote    Quote?    @relation("QuoteVersions", fields: [rootQuoteId], references: [id], onDelete: SetNull)
  rootVersions Quote[]   @relation("QuoteVersions")
  supersedesId String?   @unique
  supersedes   Quote?    @relation("QuoteSupersede", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Quote?    @relation("QuoteSupersede")
  supersededAt DateTime?

  issuedAt   DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?

  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id])
  clinicId    String
  clinic      Clinic  @relation(fields: [clinicId], references: [id])
  createdById String
  createdBy   User    @relation("QuoteAuthor", fields: [createdById], references: [id])

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  items QuoteItem[]

  @@index([clinicId, createdAt])
  @@index([clinicId, supersededAt, createdAt])
  @@index([rootQuoteId, version])
  @@index([patientId])
  @@index([createdById])
  @@index([paymentMethodId])
}

// Elementos del presupuesto. name/description/unitPrice son snapshot: un cambio
// posterior en ServiceCost o ProviderService no altera el presupuesto.
model QuoteItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  serviceCostId String?
  serviceCost   ServiceCost? @relation(fields: [serviceCostId], references: [id], onDelete: SetNull)

  providerServiceId String?
  providerService   ProviderService? @relation(fields: [providerServiceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceCostId])
  @@index([providerServiceId])
}
